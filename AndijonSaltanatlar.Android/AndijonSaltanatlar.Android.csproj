<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ANDIJON: SALTANATLAR — Android client (PROMPT 19A).
    O'yin kodi NUSXALANMAYDI: ../AndijonSaltanatlar dagi barcha .cs fayllar shu loyihaga bog'lanadi (link),
    shuning uchun Windows va Android bir xil gameplay kodini ishlatadi. Platformaga xos joylar #if ANDROID bilan.

    APK yig'ish (Android workload, JDK 17 va Android SDK kerak — docs/ANDROID_BUILD.md):
      dotnet publish AndijonSaltanatlar.Android -c Release -f net10.0-android
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>uz.andijon.saltanatlar</ApplicationId>
    <ApplicationVersion>9</ApplicationVersion>
    <ApplicationDisplayVersion>2.3</ApplicationDisplayVersion>
    <RootNamespace>AndijonSaltanatlar</RootNamespace>
    <AssemblyName>AndijonSaltanatlar.Android</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Sinov uchun: debug kalit bilan imzolangan APK (Play Store uchun alohida kalit kerak). -->
    <AndroidKeyStore>false</AndroidKeyStore>
    <NoWarn>$(NoWarn);CA1416;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.*" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.3.*" />
    <!-- Telefondagi Google akkauntlar ro'yxati (Android Credential Manager — "Sign in with Google"). -->
    <PackageReference Include="Xamarin.AndroidX.Credentials" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Credentials.PlayServicesAuth" Version="1.6.0.2" />
    <PackageReference Include="Xamarin.Google.Android.Libraries.Identity.GoogleId" Version="1.1.0.16" />
  </ItemGroup>

  <!-- Shriftlar APK ichiga asset sifatida (TitleContainer orqali o'qiladi). -->
  <ItemGroup>
    <AndroidAsset Include="..\AndijonSaltanatlar\Content\Fonts\*.ttf" Link="Assets\Content\Fonts\%(Filename)%(Extension)" />
    <AndroidAsset Include="..\AndijonSaltanatlar\Content\Sprites\*" Link="Assets\Content\Sprites\%(Filename)%(Extension)" />
    <!-- Kirish videosi: kadrlar (jpg) va ovoz (wav). -->
    <AndroidAsset Include="..\AndijonSaltanatlar\Content\Intro\*" Link="Assets\Content\Intro\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AndijonSaltanatlar.Shared\AndijonSaltanatlar.Shared.csproj" />
  </ItemGroup>

  <!-- Umumiy o'yin kodi (Program.cs — Windows kirish nuqtasi va oynasiz test vositalari bundan mustasno). -->
  <ItemGroup>
    <Compile Include="..\AndijonSaltanatlar\**\*.cs"
             Exclude="..\AndijonSaltanatlar\bin\**;..\AndijonSaltanatlar\obj\**;..\AndijonSaltanatlar\Program.cs;..\AndijonSaltanatlar\Online\OnlineClientSmoke.cs;..\AndijonSaltanatlar\Online\OnlineAllianceSmoke.cs"
             LinkBase="Game" />
  </ItemGroup>

</Project>
